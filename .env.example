# Claude on the Claude API (first party)
ANTHROPIC_API_KEY=
ORDERLINE_MODEL=claude-opus-5-5
ORDERLINE_EFFORT=medium

# Or Claude on Microsoft Foundry (stays in your Azure tenant's billing)
ORDERLINE_PROVIDER=anthropic          # anthropic | foundry
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=

# Microsoft 365 mailbox through Microsoft Graph (app registration, Mail.ReadWrite application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=orders@yourcompany.com
GRAPH_FOLDER=Inbox
